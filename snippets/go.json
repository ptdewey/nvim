{
  "function": {
    "prefix": "func",
    "body": [
      "func ${1}(${2}) ${3}{",
      "\t${4}",
      "}"
    ]
  },
  "method": {
    "prefix": "meth",
    "body": [
      "func (${1}) ${2}(${3}) ${4}{",
      "\t${5}",
      "}"
    ]
  },
  "type": {
    "prefix": "typ",
    "body": [
      "type ${1} ${2|struct,interface|} {",
      "\t${3}",
      "}${0}"
    ]
  },
  "print": {
    "prefix": "print",
    "body": "fmt.Println(\"${1}\")"
  },
  "log error": {
    "prefix": "lerr",
    "body": "log.Println(err)${0}"
  }
}
